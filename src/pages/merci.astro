---
import Base from '../layouts/Base.astro';
---

<Base titre="Message reçu">
  <section slot="entete" class="hero mince">
    <h1 class="slogan">Message reçu</h1>
    <p class="accroche">
      Merci. Nous lisons tout, et nous publions sous l’article les réactions qui
      prolongent la discussion — cela peut prendre quelques jours.
    </p>
  </section>

  <div class="merci">
    <p style="font-family: var(--sans); font-size: 14px;">
      <a href="/" style="color: var(--accent);">Revenir à l’accueil</a>
    </p>
  </div>
</Base>
