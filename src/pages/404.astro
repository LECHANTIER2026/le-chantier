---
import Base from '../layouts/Base.astro';
---

<Base titre="Page introuvable">
  <section slot="entete" class="hero mince">
    <h1 class="slogan">Cette page n’existe pas</h1>
    <p class="accroche">
      Le lien est peut-être ancien, ou le texte a changé d’adresse.
      <a href="/" style="color: var(--accent);">Revenir à l’accueil</a>.
    </p>
  </section>
</Base>
